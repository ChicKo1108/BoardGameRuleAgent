# Copy to .env at repository root for worker/database commands.
# Next.js reads apps/web/.env.local; copy needed server settings there.
# Real secrets must never be committed or use NEXT_PUBLIC_ prefixes.
DATABASE_URL=postgresql://boardgame:boardgame@localhost:5432/boardgame
# Model provider, credentials and model ID will be chosen after evaluation.
# SENTRY_DSN=

# Generate a random >=32-character value; never expose to public clients.
# ADMIN_API_TOKEN=

# Web and Worker must share the same private storage root/volume.
# STORAGE_ROOT=/absolute/path/to/private/boardgame-data
# PARSER_SCRIPT=/absolute/path/to/boardgame-rules-agent/services/document-parser/parse.py
# PARSER_PYTHON=/absolute/path/to/python/with/pdfplumber

# Optional vector Worker. Default is pdf; use vectors or pdf,vectors.
# WORKER_TASKS=pdf,vectors,evaluations,answer-evaluations
# All embedding fields stay server-side. No vendor or paid model is selected implicitly.
# EMBEDDING_ENDPOINT=https://provider.example/v1/embeddings
# EMBEDDING_API_KEY=
# EMBEDDING_PROVIDER_ID=
# EMBEDDING_MODEL=
# EMBEDDING_REVISION=deployment-v1
# EMBEDDING_DIMENSIONS=
# EMBEDDING_SEND_DIMENSIONS=false
# EMBEDDING_MAX_INPUT_CHARS=2000
# EMBEDDING_DOCUMENT_PREFIX=
# EMBEDDING_QUERY_PREFIX=
# Tests use local native Postgres with pgvector, or a dedicated loopback test admin.
# PG_TEST_BIN=/opt/homebrew/opt/postgresql@18/bin
# TEST_DATABASE_ADMIN_URL=postgresql://postgres:test-password@127.0.0.1:5432/postgres

# Pi 问答。未配置 CHAT_MODEL 时管理员问答返回 CHAT_NOT_CONFIGURED。
# 只在服务端配置；不要将密钥放 NEXT_PUBLIC_*。base URL 不含 /chat/completions。
# CHAT_BASE_URL=https://tokenhub.tencentmaas.com/v1
# CHAT_API_KEY=
# CHAT_PROVIDER_ID=tencent-tokenhub
# CHAT_MODEL=<选择支持工具调用的模型 ID>
# CHAT_MODEL_REVISION=<记录此次验证所用版本或日期>
# CHAT_CONTEXT_WINDOW=<该模型上下文上限>
# CHAT_INPUT_USD_PER_MILLION=<按供应商当前价格换算成美元每百万输入 token>
# CHAT_OUTPUT_USD_PER_MILLION=<按供应商当前价格换算成美元每百万输出 token>

# 部署时记录实际 Git SHA，以关联问答运行与部署代码；本地可省略。
# Publication requires the full 40-character deployed Git commit; Web and workers must match.
# APP_REVISION=
