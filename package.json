{
  "name": "boardgame-rules-agent",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.19.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@boardgame/web",
    "build": "npm run build --workspace=@boardgame/web",
    "start": "npm run start --workspace=@boardgame/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "worker:check": "npm run check --workspace=@boardgame/worker",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:migrate": "tsx packages/db/src/cli.ts up",
    "db:revert": "tsx packages/db/src/cli.ts down",
    "db:status": "tsx packages/db/src/cli.ts status",
    "typecheck:tests": "tsc -p tests/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "embedded-postgres": "18.6.0-beta.19",
    "tsx": "^4.0.0",
    "typescript": "~5.9.0"
  }
}
